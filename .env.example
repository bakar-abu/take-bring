# Copy to `.env` and fill in secrets. Never commit `.env`.

# Public site URL
NEXT_PUBLIC_SITE_URL=https://take-bring.eu

# Microsoft Clarity (session replays / heatmaps) — free npm SDK @microsoft/clarity
NEXT_PUBLIC_CLARITY_PROJECT_ID=xnbmal94h3

# Tawk.to live chat — Administration → Channels → Chat Widget → Direct Chat Link
# Link looks like https://tawk.to/chat/PROPERTY_ID/WIDGET_ID
NEXT_PUBLIC_TAWK_PROPERTY_ID=
NEXT_PUBLIC_TAWK_WIDGET_ID=
