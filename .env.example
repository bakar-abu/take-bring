NEXT_PUBLIC_SITE_URL=https://take-bring.eu

# Set to false or 0 to block search indexing (robots.txt disallow + noindex meta).
# Recommended for localhost / staging. Omit or set true when going live.
INDEXING_ENABLED=false

GOOGLE_SITE_VERIFICATION=

# Microsoft Clarity (session analytics). Loaded only after cookie consent is accepted.
NEXT_PUBLIC_CLARITY_PROJECT_ID=xnbmal94h3

# Dashboard login (/tb-dashboard)
DASHBOARD_EMAIL=
DASHBOARD_PASSWORD=
DASHBOARD_SESSION_SECRET=

# --- SMTP (KAS / All-inkl) — used by Nodemailer for contact & lead forms ---
# Outgoing: w01f4ba3.kasserver.com:465 SSL
SMTP_HOST=w01f4ba3.kasserver.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@take-bring.eu
SMTP_PASS=Take-bring1988
# Who receives form submissions
MAIL_TO=info@take-bring.eu

# Optional: From display name (mailbox must still be SMTP_USER)
MAIL_FROM_NAME=Take & Bring Website
